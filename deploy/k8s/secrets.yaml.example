# Template — fill in via your secret store. DO NOT commit a populated copy.
apiVersion: v1
kind: Secret
metadata:
  name: algotrader-secrets
  namespace: algotrader
type: Opaque
stringData:
  # Hard guardrail: real-money trading requires LIVE=true here AND
  # per-strategy live: true in the config.
  LIVE: "false"

  DATABASE_URL: "postgresql://algotrader:CHANGEME@postgres:5432/algotrader"
  REDIS_URL: "redis://redis:6379/0"

  ALPACA_API_KEY: "REPLACE_ME"
  ALPACA_API_SECRET: "REPLACE_ME"

  # Optional alerting (omit if unused):
  SLACK_WEBHOOK_URL: ""
  DISCORD_WEBHOOK_URL: ""
  SMTP_HOST: ""
  SMTP_PORT: "587"
  SMTP_USER: ""
  SMTP_PASS: ""
  SMTP_FROM: ""
  SMTP_TO: ""
  TWILIO_ACCOUNT_SID: ""
  TWILIO_AUTH_TOKEN: ""
  TWILIO_FROM: ""
  TWILIO_TO: ""
